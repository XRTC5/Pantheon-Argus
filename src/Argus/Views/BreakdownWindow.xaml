<Window x:Class="Argus.Views.BreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Argus - what is under this"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        Width="400" Height="560" MinWidth="280" MinHeight="200">

    <!--
        A real window rather than the in-panel view this started as, and rather
        than a Popup.

        The panel is a glance and this is a thing you read while looking at the
        panel, so it cannot be something that covers it. A Popup would not do
        either: a popup is owned by its opener, and Argus deliberately lives at
        the bottom of the window stack in its default mode, so an owned popup
        inherits exactly the occlusion problem this window exists to avoid.
        Topmost, unowned, dragged by its header, closed with the button or Esc.
    -->

    <Window.Resources>

        <!-- One line: a process, a console, a task. -->
        <DataTemplate x:Key="DetailItemTemplate">
            <Border Margin="{Binding Depth, Converter={StaticResource DepthIndent}}"
                    Padding="0,3,0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="5" Height="5"
                             VerticalAlignment="Top" Margin="0,5,0,0"
                             Fill="{Binding State, Converter={StaticResource StateBrush}}" />

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Title}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource RowSub}" Text="{Binding Sub}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Sub, Converter={StaticResource EmptyHide}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Style="{StaticResource RowDetail}"
                               Text="{Binding Detail}" VerticalAlignment="Top" Margin="0,1,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DetailGroupTemplate">
            <StackPanel Margin="0,0,0,10">
                <!-- Stacked, not overlaid. The shared SectionHeader style
                     carries the bottom margin that keeps a rule clear of the
                     text; overriding Margin to zero put the line straight
                     through the words. -->
                <StackPanel Margin="0,6,0,4">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Title}"
                               Margin="0,0,0,5" />
                    <Rectangle Height="1" Fill="{StaticResource RuleSoft}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource DetailItemTemplate}"
                              VirtualizingPanel.IsVirtualizing="False" />

                <!-- An empty group still says something. "None in the retention
                     window" is an answer; a missing section is a question. -->
                <TextBlock Style="{StaticResource RowSub}" Text="{Binding Empty}"
                           Margin="14,0,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource EmptyHide}}" />
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Border Background="{StaticResource Bg}" BorderThickness="1"
            BorderBrush="{StaticResource Rule}" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header. Drag anywhere on it to move the window. -->
            <Border Grid.Row="0" Background="{StaticResource BgRaised}" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="Header_Drag">
                <Grid Margin="12,10,10,10">
                    <StackPanel Margin="0,0,64,0">
                        <TextBlock Text="UNDER THIS" FontFamily="{StaticResource UiFont}"
                                   FontSize="9" Foreground="{StaticResource TextFaint}" />
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiFont}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextHi}" TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource GlyphButton}" Content="CLOSE"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ScrollViewer.Resources>

                <StackPanel Margin="12,8,12,18">
                    <TextBlock Text="{Binding Summary}"
                               FontFamily="{StaticResource UiFont}" FontSize="11"
                               LineHeight="16" Foreground="{StaticResource TextMid}"
                               TextWrapping="Wrap" Margin="0,0,0,4" />

                    <ItemsControl ItemsSource="{Binding Groups}"
                                  ItemTemplate="{StaticResource DetailGroupTemplate}"
                                  VirtualizingPanel.IsVirtualizing="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
