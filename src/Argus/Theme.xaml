<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:v="clr-namespace:Argus.Views">

    <!--
        The look is built entirely from solid fills, 1px rules and type.

        No blur, no drop shadow, no opacity masks, no storyboards. Every one of
        those forces WPF to render the panel through an intermediate surface
        on each frame, and this window is on screen permanently. A panel that
        looks expensive should not be expensive: the futurism here is in the
        typography and the restraint, not in effects.
    -->

    <v:StateToBrushConverter x:Key="StateBrush" />
    <v:EmptyToCollapsedConverter x:Key="EmptyHide" />
    <v:FractionToWidthConverter x:Key="FractionWidth" />

    <!-- ============================================================ palette -->

    <!-- Frozen: a frozen brush is shared across every use instead of being
         cloned per element, and can be handed to the render thread directly. -->
    <SolidColorBrush x:Key="Bg"        Color="#070B10" po:Freeze="True" />
    <SolidColorBrush x:Key="BgRaised"  Color="#0C1218" po:Freeze="True" />
    <SolidColorBrush x:Key="Rule"      Color="#16202B" po:Freeze="True" />
    <SolidColorBrush x:Key="RuleSoft"  Color="#101823" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent"    Color="#22D3EE" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentDim" Color="#0E4A56" po:Freeze="True" />
    <SolidColorBrush x:Key="TextHi"    Color="#C9D8E6" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMid"   Color="#7C93A8" po:Freeze="True" />
    <SolidColorBrush x:Key="TextLow"   Color="#4C6076" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFaint" Color="#33445A" po:Freeze="True" />
    <SolidColorBrush x:Key="Amber"     Color="#F5A524" po:Freeze="True" />
    <SolidColorBrush x:Key="Danger"    Color="#FF5C5C" po:Freeze="True" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============================================================= text -->

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
        <!-- Letterspacing is the cheapest way to make small caps read as a
             system label rather than as body text. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Margin" Value="12,14,12,6" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowDetail" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="RowSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- ============================================================ buttons -->

    <Style x:Key="GlyphButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0F1922" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#13212C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deliberately quiet: this sits inside a dense list and must not shout
         louder than the status dot beside it. Stop turns red only on hover, so
         the destructive option is obvious at the moment of pressing it and
         invisible the rest of the time. -->
    <Style x:Key="ControlButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="8.5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0F1922" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Control}" Value="Stop">
                            <Setter Property="Foreground" Value="#7A4A4A" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Control}" Value="Stop" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Danger}" />
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleChip" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0B2B33" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== scrollbar -->
    <!-- The default WPF scrollbar is 17px of grey chrome and would dominate a
         330px panel. This is a 4px rule that only exists while it is useful. -->

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#25384A" CornerRadius="2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The default WPF tooltip is a pale box with a 3D border. Next to this
         panel it reads as an error, not an explanation. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#0C1218" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentDim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2" MaxWidth="420">
                        <TextBlock Text="{TemplateBinding Content}" Margin="12,10"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5" LineHeight="17"
                                   Foreground="{StaticResource TextHi}"
                                   TextWrapping="Wrap" MaxWidth="396" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
